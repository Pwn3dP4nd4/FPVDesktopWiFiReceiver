# FPVDesktopWiFiReceiver: acceso USB sin root a los adaptadores RTL8812BU / 8812CU / 8812EU que usa wifi-sdr.
#   sudo cp 60-kepyur.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# El driver del kernel (rtw88_8822bu) se desconecta solo al abrir el adaptador (libusb detach).
# Acceso: solo el usuario con sesion local (uaccess, systemd-logind), no cualquier usuario o servicio del equipo
# (antes MODE="0666"). Sin sesion local (por ssh, sin logind), una regla propia con GROUP="<grupo>", MODE="0660".
# Realtek: 8812BU (BrosTrend AC1200 AC1L/AC3L/AC5L y otros), 8812CU, 8812EU
SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="b812", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="c812", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="a81a", TAG+="uaccess"
# TP-Link Archer T4U v3, T3U, T3U Plus (RTL8812BU)
SUBSYSTEM=="usb", ATTRS{idVendor}=="2357", ATTRS{idProduct}=="0115", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="2357", ATTRS{idProduct}=="012d", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="2357", ATTRS{idProduct}=="0138", TAG+="uaccess"
# Linksys WUSB6300 V2 (RTL8812BU; la V1, 13b1:003f, es RTL8812AU y no vale)
SUBSYSTEM=="usb", ATTRS{idVendor}=="13b1", ATTRS{idProduct}=="0045", TAG+="uaccess"
