# kepyur-desktop: acceso USB sin root a los adaptadores RTL8812BU / 8812CU / 8812EU que usa wifi-sdr.
#   sudo cp 60-kepyur.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# El driver del kernel (rtw88_8822bu) se desconecta solo al abrir el adaptador (libusb detach).
# Realtek: 8812BU (BrosTrend AC1200 AC1L/AC3L/AC5L y otros), 8812CU, 8812EU
SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="b812", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="c812", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="a81a", MODE="0666", TAG+="uaccess"
# TP-Link Archer T4U v3, T3U, T3U Plus (RTL8812BU)
SUBSYSTEM=="usb", ATTRS{idVendor}=="2357", ATTRS{idProduct}=="0115", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="2357", ATTRS{idProduct}=="012d", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="2357", ATTRS{idProduct}=="0138", MODE="0666", TAG+="uaccess"
