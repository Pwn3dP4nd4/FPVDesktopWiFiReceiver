; FPVDesktopWiFiReceiver: driver WinUSB para los adaptadores RTL8812BU (sustituye a Zadig).
;
; Por que existe: Windows trae su propio driver Realtek (netrtwlanu.inf) para 0BDA:B812 y lo vuelve a poner
; cada vez que el adaptador se enumera (al enchufarlo o al pasar de USB 2 a USB 3). El WinUSB que genera Zadig
; empata con el en puntuacion y pierde el desempate por fecha (2012 frente a 2019).
; Este INF gana asi:
;   - FeatureScore 0x80 (lo que decide): el driver Realtek que trae Windows Update (netrtwlanu.inf 1030.52, 2026)
;     declara 0xFE y el feature score pesa mas que el ID coincidente. Sin esto ganaba siempre (00FE0001 suyo
;     frente a 00FF0000 / 00FF0001 nuestro). Con el: 00800000 en USB 2 y 00800001 en USB 3.
;   - &REV_0210 solo coincide en USB 2: en USB 3 el chip se presenta como &REV_0300 y solo vale el ID generico.
;     Frente al driver Realtek de serie de Windows (00FF0001) basta el feature score; el ID especifico es un extra.
;   - DriverVer posterior a los drivers Realtek: desempate si otro driver igualara el feature score.
; Se instala con scripts/windows-driver.ps1 (firma local, una sola vez, como administrador).

[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGuid   = {88BAE032-5A81-49F0-BC3D-A4FF138216D6}
Provider    = %ProviderName%
CatalogFile = fpvdesktopwifireceiver_winusb.cat
DriverVer   = 11/16/2026,10.0.2.0
PnpLockdown = 1

[Manufacturer]
%ProviderName% = Devices,NTamd64,NTarm64

[Devices.NTamd64]
%Dev8812BU%   = WinUsb_Install, USB\VID_0BDA&PID_B812&REV_0210
%Dev8812BU%   = WinUsb_Install, USB\VID_0BDA&PID_B812
%DevT4Uv3%    = WinUsb_Install, USB\VID_2357&PID_0115
%DevT3U%      = WinUsb_Install, USB\VID_2357&PID_012D
%DevT3UPlus%  = WinUsb_Install, USB\VID_2357&PID_0138
%DevWUSB6300v2% = WinUsb_Install, USB\VID_13B1&PID_0045

[Devices.NTarm64]
%Dev8812BU%   = WinUsb_Install, USB\VID_0BDA&PID_B812&REV_0210
%Dev8812BU%   = WinUsb_Install, USB\VID_0BDA&PID_B812
%DevT4Uv3%    = WinUsb_Install, USB\VID_2357&PID_0115
%DevT3U%      = WinUsb_Install, USB\VID_2357&PID_012D
%DevT3UPlus%  = WinUsb_Install, USB\VID_2357&PID_0138
%DevWUSB6300v2% = WinUsb_Install, USB\VID_13B1&PID_0045

[WinUsb_Install]
Include      = winusb.inf
Needs        = WINUSB.NT
FeatureScore = 0x80

[WinUsb_Install.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services

[WinUsb_Install.HW]
AddReg = WinUsb_AddReg

[WinUsb_AddReg]
; interfaz de dispositivo para que libusb pueda abrirlo
HKR,,DeviceInterfaceGUIDs,0x10000,"{5514ADA9-AB6F-4807-B61D-E6A9BBF5B18F}"

[Strings]
ProviderName = "FPVDesktopWiFiReceiver"
Dev8812BU    = "RTL8812BU (FPVDesktopWiFiReceiver, WinUSB)"
DevT4Uv3     = "TP-Link Archer T4U v3 (FPVDesktopWiFiReceiver, WinUSB)"
DevT3U       = "TP-Link Archer T3U (FPVDesktopWiFiReceiver, WinUSB)"
DevT3UPlus   = "TP-Link Archer T3U Plus (FPVDesktopWiFiReceiver, WinUSB)"
DevWUSB6300v2 = "Linksys WUSB6300 V2 (FPVDesktopWiFiReceiver, WinUSB)"
